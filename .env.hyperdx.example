# ===========================================
# HyperDX 可选集成配置
# ===========================================
# 将以下变量添加到 .env.production 中，即可启用 OTel 数据上报
# 不设置时应用正常运行，无任何 OTel 开销

# OTel Collector 端点（HyperDX 的 OTel Collector 地址）
# 同机部署：http://localhost:4318
# 独立部署：http://<hyperdx-server-ip>:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 服务名称（在 HyperDX 面板中显示的名称）
OTEL_SERVICE_NAME=next-hono-admin
